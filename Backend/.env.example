PORT=4000
MONGODB_URI=
JWT_SECRET=
OPENWEATHER_API_KEY=
# https://www.weatherapi.com/ — preferred for /weather district details when set
WEATHERAPI_KEY=
ACCUWEATHER_API_KEY=
FIRECRAWL_API_KEY=

# RapidAPI: only needed to refresh Backend/data/districts.json and cities.json
# npm run seed:lk-locations
# https://rapidapi.com/teskill-teskill-default/api/sri-lankan-provinces-districts-and-cities1
# RAPIDAPI_LK_LOCATIONS_KEY=

# Comma-separated emails that can access admin volunteer approval (must match login email).
ADMIN_EMAILS=you@example.com

# Optional Python face-analysis service. When unset, scans are recorded as unavailable.
# FACE_RECOGNITION_URL=http://127.0.0.1:8010

# Victim identification: a vision AI reads scars, tattoos, clothing etc. from scan photos
# to pre-fill the officer review form.
# Default: free local model via Ollama (photos stay on this machine):
#   brew install ollama && ollama serve && ollama pull qwen2.5vl:7b
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Alternative: Claude via Anthropic's API (paid; photos are sent to Anthropic).
# Setting ANTHROPIC_API_KEY switches to it unless ATTRIBUTE_EXTRACTION_PROVIDER=ollama.
# ATTRIBUTE_EXTRACTION_PROVIDER=ollama
# ANTHROPIC_API_KEY=sk-ant-...

# Victim scan photos are stored encrypted (AES-256-GCM) on this server's disk for admin
# review, under Backend/storage/scan-photos (git-ignored). Without SCAN_PHOTO_KEY a key file
# is created there automatically; back it up, since losing it makes stored photos unreadable.
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SCAN_PHOTO_KEY=
# SCAN_PHOTO_DIR=
# Photos are deleted with their case; abandoned drafts are deleted after 1 day; other photos after:
# SCAN_PHOTO_RETENTION_DAYS=90

# Users with no login in this many days (or never logged in and account older than this) are "inactive" and may be removed by admin.
# ADMIN_INACTIVE_USER_DAYS=90

# Local dev only: set to "true" so any logged-in user can approve volunteers (no ADMIN_EMAILS needed).
# Do not enable in production.
# ALLOW_VOLUNTEER_ADMIN_ANY_USER=true

# Cloudinary (for user incident media uploads: image/video)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=961357775579339
# CLOUDINARY_API_SECRET=

# Local dev: allow POST /auth/dev-admin-token so the login shortcut admin@admin.com / admin@123 gets a real JWT
# (needed for SOS admin, volunteer admin, etc.). Never enable in production.
# ALLOW_DEV_ADMIN_JWT=true
