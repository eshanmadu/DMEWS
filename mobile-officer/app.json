{
  "expo": {
    "name": "Mobile Officer",
    "slug": "mobile-officer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "API_URL": "http://localhost:4000"
    }
  }
}
